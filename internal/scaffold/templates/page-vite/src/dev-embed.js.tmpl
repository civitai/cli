// Dev-server embeddability for `civitai app dev-tunnel`.
//
// The dev tunnel serves THIS local dev server as a `dev-<16hex>.civit.ai` host
// that the real Civitai `/apps/dev/<blockId>` page (on civitai.com, civitai.red
// or civitai.green) iframes. For that embed to work the dev server must admit
// the tunnel host and, during a dev-tunnel session, be framable BY every Civitai
// domain. vite.config.js imports these
// values into `server.*`, which is DEV-ONLY: it never applies to `vite build`,
// so the production bundle is untouched.
//
// The values are the same ones the page-elements and page-money scaffolds ship
// in their src/dev-embed.ts (the CLI's dev-tunnel preflight checks for them).

/**
 * The Civitai host origins that embed this app: every Civitai domain serves the
 * `/apps/dev` preview route. The dev server's frame-ancestors CSP is built from
 * this one list.
 */
export const CIVITAI_PARENT_ORIGINS = [
{{ civitaiParentOriginsJS }}];

/**
 * The host suffix the tunnel serves the dev server on (`dev-<16hex>.civit.ai`).
 * Vite's DNS-rebinding host check must allow it, or the tunneled request is
 * 403'd before it reaches the app. A leading-dot entry matches any subdomain.
 */
export const DEV_TUNNEL_HOST_SUFFIX = '.civit.ai';

/** Hosts the dev server accepts (Vite `server.allowedHosts`). */
export const DEV_ALLOWED_HOSTS = ['localhost', DEV_TUNNEL_HOST_SUFFIX];

/**
 * The env flag that marks a dev-tunnel session. `npm run dev:tunnel` sets it,
 * and so does anything else that serves this dev server through the tunnel
 * (e.g. `CIVITAI_DEV_TUNNEL_HMR=1 npm run dev`). Named for its first use —
 * routing HMR over the tunnel — it also gates devServerSecurityHeaders().
 * vite.config reads it with loadEnv(mode, cwd, ''), so a value exported in the
 * shell counts as well as one set by an npm script.
 */
export const DEV_TUNNEL_ENV = 'CIVITAI_DEV_TUNNEL_HMR';

/** True in a dev-tunnel session: DEV_TUNNEL_ENV is '1' or 'true'. */
export function isDevTunnel(env) {
  const v = env[DEV_TUNNEL_ENV];
  return v === '1' || v === 'true';
}

/**
 * Response headers that make the dev server iframe-embeddable from Civitai.
 * vite.config.js sends them ONLY in a dev-tunnel session (isDevTunnel): on a
 * plain `npm run dev`, `Access-Control-Allow-Origin: *` would let any page open
 * in the same browser read this dev server's source.
 *
 * 1. A `frame-ancestors` CSP scoped to the Civitai domains (+ self) so each may
 *    frame it. Do NOT add `X-Frame-Options` — it would block the cross-origin
 *    embed whatever the CSP says.
 * 2. `Access-Control-Allow-Origin: *` so the ES modules load: the host iframes
 *    the app sandboxed at a null origin, and every module fetch from it is
 *    CORS-checked. Module fetches are non-credentialed, so `*` is correct.
 */
export function devServerSecurityHeaders() {
  return {
    'Content-Security-Policy': `frame-ancestors 'self' ${CIVITAI_PARENT_ORIGINS.join(' ')}`,
    'Access-Control-Allow-Origin': '*',
  };
}
