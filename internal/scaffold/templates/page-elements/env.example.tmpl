# Comma-separated list of allowed parent-frame origins. The bridge drops every
# postMessage whose `event.origin` isn't in this list.
#
# In production, this value is platform-injected at build time by the App Blocks
# build recipe (it sets an ENV that Vite prioritizes over .env files), so the
# value here only matters for LOCAL DEV — and `.env.development` already sets it
# for `npm run dev:harness`. Left unset, @civitai/sdk falls back to the canonical
# civitai.com origins — which is why the dev harness, whose fake host posts from
# the dev server's own origin, needs it set:
#   VITE_BLOCK_ALLOWED_PARENT_ORIGINS=http://localhost:5186,https://civitai.com
#
# `civitai app submit` UPLOADS this file verbatim, so it holds documented
# placeholders only — never a secret.
VITE_BLOCK_ALLOWED_PARENT_ORIGINS=

# Set to "true" to install the dev harness (simulates BLOCK_INIT locally without
# civitai.com embedding the app). `npm run dev:harness` flips this on for you.
VITE_DEV_HARNESS=
