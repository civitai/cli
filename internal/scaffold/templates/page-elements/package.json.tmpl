{
  "name": "{{ .Slug }}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:harness": "VITE_DEV_HARNESS=true vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "comment-overrides": [
    "SECURITY CONSTRAINTS ON TRANSITIVE DEPENDENCIES, carried over verbatim from",
    "the civitai-block-starter starter. Both blocks are needed: npm reads",
    "`overrides`, pnpm reads `pnpm.overrides`. Keep them in step."
  ],
  "overrides": {
    "cookie@<0.7.0": "^0.7.0",
    "postcss@<8.5.10": ">=8.5.10"
  },
  "pnpm": {
    "overrides": {
      "cookie@<0.7.0": "^0.7.0",
      "postcss@<8.5.10": ">=8.5.10"
    }
  },
  "dependencies": {
    "@civitai/app-sdk": "^0.58.0",
    "@civitai/components": "^0.9.0",
    "@civitai/sdk": "^0.10.0",
    "@civitai/theme": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ajv": "^8.17.1",
    "happy-dom": "^20.9.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
